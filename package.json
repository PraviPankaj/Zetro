{
  "name": "zetro",
  "private": true,
  "scripts": {
    "dev:api": "cd backend && .venv/bin/python -m uvicorn app.main:app --reload --port 8000",
    "dev:web": "npm --prefix apps/web run dev",
    "sync-openapi": "node packages/api-client/src/sync-openapi.mjs",
    "build": "npm install --prefix apps/web && npm run build --prefix apps/web",
    "start": "npm start --prefix apps/web"
  }
}
