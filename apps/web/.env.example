NEXT_PUBLIC_API_URL=http://localhost:8000

# Vercel: leave NEXT_PUBLIC_API_URL unset and set API_URL to the zetro-api Vercel project URL
# (rewrites /api and /media to that backend).
# API_URL=https://zetro-api.vercel.app

# Firebase Phone Auth (client). Leave blank to use console/dev OTP.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
