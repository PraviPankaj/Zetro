DATABASE_URL=sqlite:///./zetro.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-zetro-dev-secret-key-32chars
ENCRYPTION_KEY=zetro-dev-fernet-key-change-in-prod!!
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000

# Demo shop — one-click admin login at /abc/admin/login (no OTP)
DEMO_BYPASS_ENABLED=true
DEMO_SHOP_SLUG=abc
DEMO_SHOP_PHONE=9999999999

# SMS OTP — console = no SMS; OTP shown in API/UI as dev_otp
SMS_PROVIDER=console
USE_MEMORY_OTP=true

# Auth — console keeps server OTP; set firebase when Phone Auth is enabled
AUTH_PROVIDER=console
# Paste service account JSON as one line, or path to the file:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccount.json

# Platform admin (seeded on first startup)
PLATFORM_DEFAULT_USERNAME=admin
PLATFORM_DEFAULT_PASSWORD=admin

# --- Optional: add when you enable real SMS (DLT) ---
# FAST2SMS_API_KEY=...
# MSG91_AUTH_KEY=...

# OpenAI / ChatGPT
# CHATGPT_API_KEY=sk-...
